package components

templ Header() {
	<header class="site-header">
		<div class="header-container">
			<div class="site-title">
				<span>VorcaroZAP</span>
				<span class="badge">Fase 1 — Fundação</span>
			</div>
			<p class="site-tagline">
				Plataforma documental e investigativa com fontes rastreáveis, classificação editorial e métricas públicas.
			</p>
		</div>
	</header>
}
