package pages

import (
	"fmt"
	"github.com/raphaieu/vorcarozap/web/components"
)

templ AdminCandidates(vm AdminCandidateListVM) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Listagem de candidatos descobertos pelo monitoramento automatizado no VorcaroZAP."/>
			<title>Candidatos de Monitoramento — Admin — VorcaroZAP</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body>
			@components.AdminNav("candidatos")
			<main class="container">
				<!-- Cabeçalho da Página -->
				<header class="page-intro">
					<h1 class="page-title">Candidatos de Monitoramento</h1>
					<p class="page-subtitle">
						Extrações estruturadas da esteira de descoberta e avaliação. Candidatos em quarentena não são expostos na navegação pública.
					</p>
				</header>

				<!-- Formulário de Filtros e Busca -->
				<section class="card filter-card" aria-label="Filtros de Candidatos">
					<form method="GET" action="/admin/candidatos" class="filter-form">
						<div class="search-row">
							<div class="form-group flex-grow">
								<label for="search-input" class="form-label">Busca Textual</label>
								<input
									type="search"
									id="search-input"
									name="q"
									class="form-control"
									placeholder="Buscar por entidade, alvo, proposição, título ou URL da fonte..."
									value={ vm.Filter.Search }
								/>
							</div>
							<div class="form-actions-inline">
								<button type="submit" class="btn btn-primary">Filtrar</button>
								if vm.Filter.Search != "" || vm.Filter.Status != "" || vm.Filter.Grade != "" || vm.Filter.RunID != "" || (vm.Filter.Period != "" && vm.Filter.Period != "all") {
									<a href="/admin/candidatos" class="btn btn-subtle">Limpar</a>
								}
							</div>
						</div>

						<div class="filters-grid">
							<!-- Filtro de Status Editorial -->
							<div class="form-group">
								<label for="filter-status" class="form-label">Status Editorial</label>
								<select id="filter-status" name="status" class="form-control" onchange="this.form.submit()">
									<option value="">Todos os status</option>
									<option value="quarantined" selected?={ vm.Filter.Status == "quarantined" }>Quarentena (Não público)</option>
									<option value="published" selected?={ vm.Filter.Status == "published" }>Publicado (Público)</option>
									<option value="rejected" selected?={ vm.Filter.Status == "rejected" }>Rejeitado (Não público)</option>
									<option value="archived" selected?={ vm.Filter.Status == "archived" }>Arquivado (Não público)</option>
								</select>
							</div>

							<!-- Filtro de Grau -->
							<div class="form-group">
								<label for="filter-grade" class="form-label">Grau Sugerido</label>
								<select id="filter-grade" name="grade" class="form-control" onchange="this.form.submit()">
									<option value="">Todos os graus</option>
									<option value="A" selected?={ vm.Filter.Grade == "A" }>Grau A (Documento direto)</option>
									<option value="B" selected?={ vm.Filter.Grade == "B" }>Grau B (Reportagem fundamentada)</option>
									<option value="C" selected?={ vm.Filter.Grade == "C" }>Grau C (Associação documentada)</option>
									<option value="D" selected?={ vm.Filter.Grade == "D" }>Grau D (Alegação atribuída)</option>
									<option value="E" selected?={ vm.Filter.Grade == "E" }>Grau E (Pista ou menção)</option>
								</select>
							</div>

							<!-- Filtro de Período -->
							<div class="form-group">
								<label for="filter-period" class="form-label">Período de Criação</label>
								<select id="filter-period" name="period" class="form-control" onchange="this.form.submit()">
									<option value="all" selected?={ vm.Filter.Period == "" || vm.Filter.Period == "all" }>Todo o histórico</option>
									<option value="7d" selected?={ vm.Filter.Period == "7d" }>Últimos 7 dias</option>
									<option value="30d" selected?={ vm.Filter.Period == "30d" }>Últimos 30 dias</option>
									<option value="90d" selected?={ vm.Filter.Period == "90d" }>Últimos 90 dias</option>
								</select>
							</div>

							<!-- Filtro por Run ID -->
							<div class="form-group">
								<label for="filter-run-id" class="form-label">ID da Execução (Run)</label>
								<input
									type="text"
									id="filter-run-id"
									name="run_id"
									class="form-control"
									placeholder="Filtrar por run_id..."
									value={ vm.Filter.RunID }
								/>
							</div>
						</div>
					</form>
				</section>

				<!-- Cabeçalho de Resultados -->
				<div class="results-header">
					<span class="results-count">
						<strong>{ fmt.Sprintf("%d", vm.Filter.TotalCount) }</strong> candidatos encontrados
					</span>
					if vm.Filter.TotalPages > 1 {
						<span class="pagination-status">
							Página { fmt.Sprintf("%d", vm.Filter.Page) } de { fmt.Sprintf("%d", vm.Filter.TotalPages) }
						</span>
					}
				</div>

				<!-- Listagem de Candidatos -->
				if len(vm.Candidates) == 0 {
					<section class="card empty-state" aria-label="Nenhum Candidato Encontrado">
						<h3>Nenhum candidato encontrado</h3>
						<p>Nenhum registro de monitoramento corresponde aos critérios de busca ou filtros selecionados.</p>
					</section>
				} else {
					<div class="admin-items-list" aria-label="Lista de Candidatos">
						for _, c := range vm.Candidates {
							<article class="card admin-item-card">
								<div class="admin-item-header">
									<div class="admin-item-title-group">
										<div class="admin-item-title-row">
											<span class="admin-subject-name">{ c.EntityName }</span>
											if c.TargetEntityName != "" {
												<span class="relation-target">&rarr; { c.TargetEntityName }</span>
											} else if c.CaseName != "" {
												<span class="relation-target">&rarr; Caso: { c.CaseName }</span>
											}
											if c.RelationshipType != "" {
												<span class="category-badge">{ c.RelationshipType }</span>
											}
										</div>
										<div class="admin-item-meta-row">
											<span>Data: <strong>{ c.CreatedAtHuman }</strong></span>
											<span>Confiança: <strong>{ c.ConfidenceHuman }</strong></span>
											if c.RunDiscoveryModel != "" {
												<span>Modelo: <code>{ c.RunDiscoveryModel }</code></span>
											}
										</div>
									</div>

									<div class="badge-cluster">
										<span class={ "grade-badge", "grade-" + c.SuggestedGrade }>
											{ c.SuggestedGradeHuman }
										</span>
										if c.EditorialStatus == "quarantined" {
											<span class="admin-status-badge status-quarantined">Quarentena (Não público)</span>
										} else if c.EditorialStatus == "published" {
											<span class="admin-status-badge status-published">Publicado</span>
										} else if c.EditorialStatus == "rejected" {
											<span class="admin-status-badge status-rejected">Rejeitado</span>
										} else {
											<span class="admin-status-badge status-archived">Arquivado</span>
										}
										if c.IsDuplicate {
											if c.CanonicalCandidateID != "" {
												<a
													href={ templ.SafeURL("/admin/candidatos/" + c.CanonicalCandidateID) }
													class="admin-duplicate-badge"
													title={ "Duplicata de " + c.CanonicalCandidateID + " (" + c.DuplicateReason + ")" }
												>
													Duplicata &rarr; Canônico
												</a>
											} else {
												<span class="admin-duplicate-badge">Duplicata</span>
											}
										}
									</div>
								</div>

								<!-- Proposição -->
								<div class="admin-item-body">
									<p class="admin-item-proposition">{ c.Proposition }</p>

									<!-- Trecho / Fonte -->
									if c.Excerpt != "" {
										<div class="source-excerpt">
											&ldquo;{ c.Excerpt }&rdquo;
											if c.Locator != "" {
												<span class="source-locator">{ c.Locator }</span>
											}
										</div>
									}

									<!-- Fonte / Link -->
									<div class="admin-item-source-info">
										<span class="meta-item">
											Fonte:
											if c.SourceTitle != "" {
												<strong>{ c.SourceTitle }</strong>
											}
											if c.PublisherOrAuthor != "" {
												<span>({ c.PublisherOrAuthor })</span>
											}
										</span>
										if c.CanonicalURL.IsValid {
											<a
												href={ templ.SafeURL(c.CanonicalURL.SafeURL) }
												target="_blank"
												rel="noopener noreferrer"
												class="source-external-link"
												title="Abrir URL original da fonte em nova aba"
											>
												Abrir fonte externa &UpperRightArrow;
											</a>
										} else if c.CanonicalURL.RawURL != "" {
											<span class="source-url-invalid" title="URL externa inválida ou insegura" style="font-size: 0.85rem; color: var(--color-text-muted);">
												{ c.CanonicalURL.RawURL } <em>(URL inválida ou insegura)</em>
											</span>
										}
									</div>

									<!-- Gates & Ação de Política -->
									<div class="admin-gates-summary">
										<div class="gate-indicator">
											Gate Estrutural:
											if c.StructuralGatePassed.Valid && c.StructuralGatePassed.Int64 == 1 {
												<span class="gate-badge gate-pass">Aprovado</span>
											} else if c.StructuralGatePassed.Valid && c.StructuralGatePassed.Int64 == 0 {
												<span class="gate-badge gate-fail">Reprovado</span>
											} else {
												<span class="gate-badge gate-pending">Pendente</span>
											}
										</div>
										<div class="gate-indicator">
											Gate Semântico:
											if c.SemanticGatePassed.Valid && c.SemanticGatePassed.Int64 == 1 {
												<span class="gate-badge gate-pass">Aprovado</span>
											} else if c.SemanticGatePassed.Valid && c.SemanticGatePassed.Int64 == 0 {
												<span class="gate-badge gate-fail">Reprovado</span>
											} else {
												<span class="gate-badge gate-pending">Pendente</span>
											}
										</div>
										if c.PolicyAction != "" {
											<div class="gate-indicator">
												Política: <strong>{ c.PolicyActionHuman }</strong>
											</div>
										}
									</div>
								</div>

								<div class="admin-item-footer">
									<a
										href={ templ.SafeURL("/admin/candidatos/" + c.ID) }
										class="btn btn-secondary btn-sm"
									>
										Inspecionar Candidato &rarr;
									</a>
								</div>
							</article>
						}
					</div>

					<!-- Paginação com filtros preservados -->
					if vm.Filter.TotalPages > 1 {
						<nav class="pagination-nav" aria-label="Navegação entre páginas de candidatos">
							if vm.Filter.Page > 1 {
								<a
									href={ templ.SafeURL("/admin/candidatos" + vm.Filter.BuildQueryString(vm.Filter.Page-1)) }
									class="btn-pagination"
								>
									&larr; Anterior
								</a>
							} else {
								<span class="btn-pagination disabled">&larr; Anterior</span>
							}

							<span class="pagination-status">
								Página { fmt.Sprintf("%d", vm.Filter.Page) } de { fmt.Sprintf("%d", vm.Filter.TotalPages) }
							</span>

							if vm.Filter.Page < vm.Filter.TotalPages {
								<a
									href={ templ.SafeURL("/admin/candidatos" + vm.Filter.BuildQueryString(vm.Filter.Page+1)) }
									class="btn-pagination"
								>
									Próxima &rarr;
								</a>
							} else {
								<span class="btn-pagination disabled">Próxima &rarr;</span>
							}
						</nav>
					}
				}
			</main>
		</body>
	</html>
}
