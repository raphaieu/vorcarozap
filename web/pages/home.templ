package pages

import (
	"fmt"
	"github.com/raphaieu/vorcarozap/web/components"
)

templ Home(vm HomeVM) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="VorcaroZAP — Plataforma investigativa e documental com fontes rastreáveis, classificação editorial e métricas públicas por estado ativo."/>
			<title>VorcaroZAP — Base Documental e Investigativa</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body>
			@components.Header()
			<main class="container">
				<!-- Aviso Editorial Obrigatório -->
				<section class="editorial-notice" aria-label="Aviso Legal e Editorial">
					<strong>Aviso Editorial e de Independência</strong>
					<p>
						Projeto independente de pesquisa e documentação jornalística, sem qualquer vínculo com WhatsApp, Meta Platforms Inc., Banco Master ou pessoas e organizações citadas. “WhatsApp” é marca registrada de seu titular. A identidade deste projeto adota referência cromática inspirada, sem reproduzir logotipos, ícones ou interfaces proprietárias.
					</p>
				</section>

				<!-- Aviso de Monitoramento Automático Neutro -->
				<section class="monitoring-inactive-banner" aria-label="Status do Monitoramento">
					<strong>Monitoramento automático ainda não ativado</strong>
					<span>
						A plataforma opera atualmente com a base documental consolidada até <strong>{ vm.CutoffDateHuman }</strong>, resultante da importação e curadoria inicial a partir de fontes públicas citadas. A esteira de monitoramento autônomo contínuo será habilitada em etapa posterior.
					</span>
				</section>

				<!-- Seção: Visão Geral do Acervo e Rede Elegível -->
				<section class="card" aria-label="Indicadores Documentais e Métricas da Rede">
					<h2 class="card-title">
						<span>Métricas da Rede Documental</span>
						<span class="status-tag" style="background: var(--color-brand); color: #fff;">Estado Ativo</span>
					</h2>
					<p style="font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 0.75rem;">
						Totais consolidados em tempo real. As métricas consideram alegações publicadas elegíveis, incluindo vínculos possíveis conforme a metodologia.
					</p>
					<div class="metrics-grid">
						<div class="metric-box metric-box-featured">
							<div class="metric-label">Entidades na Rede</div>
							<div class="metric-value">{ fmt.Sprintf("%d", vm.EligibleEntities) }</div>
							<div class="metric-subtitle">Pessoas e organizações elegíveis</div>
						</div>
						<div class="metric-box metric-box-featured">
							<div class="metric-label">Alegações Elegíveis</div>
							<div class="metric-value">{ fmt.Sprintf("%d", vm.EligibleClaims) }</div>
							<div class="metric-subtitle">Alegações consideradas nas métricas</div>
						</div>
						<div class="metric-box">
							<div class="metric-label">Total de Entidades</div>
							<div class="metric-value">{ fmt.Sprintf("%d", vm.TotalEntities) }</div>
							<div class="metric-subtitle">Acervo público total</div>
						</div>
						<div class="metric-box">
							<div class="metric-label">Total de Alegações</div>
							<div class="metric-value">{ fmt.Sprintf("%d", vm.TotalClaims) }</div>
							<div class="metric-subtitle">Inclui contexto e correções</div>
						</div>
						<div class="metric-box">
							<div class="metric-label">Fontes Citadas</div>
							<div class="metric-value">{ fmt.Sprintf("%d", vm.TotalSources) }</div>
							<div class="metric-subtitle">Fontes ativas distintas</div>
						</div>
						<div class="metric-box">
							<div class="metric-label">Última Atualização</div>
							<div class="metric-value" style="font-size: 1.15rem; margin-top: 0.25rem;">{ vm.LatestUpdateHuman }</div>
							<div class="metric-subtitle">Data de corte: { vm.CutoffDateHuman }</div>
						</div>
					</div>
				</section>

				<!-- Seção: Distribuições Estatísticas -->
				<div class="distributions-grid">
					<!-- Distribuição por Grau Documental -->
					<section class="card dist-card" aria-label="Distribuição por Grau">
						<h3 class="dist-card-title">Alegações por Grau Probatório (A–E)</h3>
						<p style="font-size: 0.8rem; color: var(--color-text-muted);">
							Proporção das alegações elegíveis na rede. Os links abaixo consultam o acervo público geral de pessoas e organizações.
						</p>
						<ul class="dist-list">
							for _, g := range vm.GradeDistribution {
								<li class="dist-item">
									<div class="dist-header-row">
										<span class="dist-item-label">
											<span class={ "grade-badge", "grade-" + g.Grade } style="margin-right: 0.35rem;">Grau { g.Grade }</span>
											{ g.GradeHuman }
										</span>
										<span class="dist-item-count">
											<strong>{ fmt.Sprintf("%d", g.Count) }</strong> ({ g.FormattedPercentage })
										</span>
									</div>
									<div class="metric-bar-track">
										<div class={ "metric-bar-fill", "grade-fill-" + g.Grade } style={ "width: " + g.CSSWidth + ";" }></div>
									</div>
									<a href={ templ.SafeURL(g.FilterURL) } class="dist-filter-link">
										Ver entidades com alegações Grau { g.Grade } no acervo público &rarr;
									</a>
								</li>
							}
						</ul>
					</section>

					<!-- Distribuição por Relevância Pública -->
					<section class="card dist-card" aria-label="Distribuição por Relevância">
						<h3 class="dist-card-title">Entidades por Relevância Pública (1–5)</h3>
						<p style="font-size: 0.8rem; color: var(--color-text-muted);">
							Alcance institucional das entidades qualificadas na rede. Os links de filtro abrem a consulta no acervo público geral.
						</p>
						<ul class="dist-list">
							for _, r := range vm.RelevanceDistribution {
								<li class="dist-item">
									<div class="dist-header-row">
										<span class="dist-item-label">{ r.RelevanceHuman }</span>
										<span class="dist-item-count">
											<strong>{ fmt.Sprintf("%d", r.Count) }</strong> ({ r.FormattedPercentage })
										</span>
									</div>
									<div class="metric-bar-track">
										<div class="metric-bar-fill" style={ "width: " + r.CSSWidth + ";" }></div>
									</div>
									<a href={ templ.SafeURL(r.FilterURL) } class="dist-filter-link">
										Ver entidades de nível { fmt.Sprintf("%d", r.Relevance) } no acervo público &rarr;
									</a>
								</li>
							}
						</ul>
					</section>

					<!-- Distribuição por Categoria -->
					if len(vm.CategoryDistribution) > 0 {
						<section class="card dist-card" aria-label="Distribuição por Categoria">
							<h3 class="dist-card-title">Entidades por Categoria</h3>
							<p style="font-size: 0.8rem; color: var(--color-text-muted);">
								Divisão temática das entidades da rede elegível. Os links de filtro abrem a consulta no acervo público geral.
							</p>
							<ul class="dist-list">
								for _, c := range vm.CategoryDistribution {
									<li class="dist-item">
										<div class="dist-header-row">
											<span class="dist-item-label">{ c.Category }</span>
											<span class="dist-item-count">
												<strong>{ fmt.Sprintf("%d", c.Count) }</strong> ({ c.FormattedPercentage })
											</span>
										</div>
										<div class="metric-bar-track">
											<div class="metric-bar-fill" style={ "width: " + c.CSSWidth + ";" }></div>
										</div>
										<a href={ templ.SafeURL(c.FilterURL) } class="dist-filter-link">
											Filtrar por { c.Category } no acervo público &rarr;
										</a>
									</li>
								}
							</ul>
						</section>
					}
				</div>

				<!-- Seção: Alegações Documentais Recentes -->
				if len(vm.RecentClaims) > 0 {
					<section class="card" aria-label="Alegações Recentes">
						<h2 class="card-title">
							<span>Alegações Recentes na Rede</span>
							<span class="status-tag">Corte { vm.CutoffDateHuman }</span>
						</h2>
						<p style="font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 0.75rem;">
							Últimas proposições registradas na base curada inicial com fontes citadas.
						</p>
						<div class="recent-claims-list">
							for _, rc := range vm.RecentClaims {
								<article class="recent-claim-item">
									<div class="recent-claim-top">
										<a href={ templ.SafeURL(rc.DetailURL) } class="recent-claim-entity">
											{ rc.EntityName }
										</a>
										<div class="badge-cluster">
											<span class={ "grade-badge", "grade-" + rc.Grade }>{ rc.GradeShort }</span>
											if rc.EntityCategory != "" {
												<span class="category-badge">{ rc.EntityCategory }</span>
											}
										</div>
									</div>
									if rc.ShortSynthesis != "" {
										<p class="recent-claim-synthesis">{ rc.ShortSynthesis }</p>
									}
									<div class="recent-claim-meta">
										<span>Atualizado em { rc.UpdatedAtHuman }</span>
									</div>
								</article>
							}
						</div>
					</section>
				}

				<!-- Espaço Visual: Consulta e Filtros -->
				<section class="card" aria-label="Busca e Consulta">
					<h2 class="card-title">
						<span>Consulta e Filtros Públicos</span>
						<span class="status-tag" style="background: var(--color-brand); color: #fff;">Disponível</span>
					</h2>
					<div class="placeholder-banner">
						<h3>Módulo de Consulta Pública</h3>
						<p>
							Consulte pessoas físicas e organizações catalogadas com busca por termos, filtros por Graus A–E, relevância pública (1 a 5), categorias e ordenação customizada.
						</p>
						<div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.75rem;">
							<a href="/pessoas" class="btn btn-primary">
								Acessar Consulta de Pessoas e Organizações &rarr;
							</a>
							<a href="/exportar/base.xlsx" class="btn btn-secondary" title="Exportar dados públicos em planilha XLSX">
								Exportar Base (XLSX)
							</a>
						</div>
					</div>
				</section>

				<!-- Espaço Visual: Metodologia e Critérios -->
				<section class="card" aria-label="Metodologia e Critérios">
					<h2 class="card-title">
						<span>Critérios Editoriais e Metodologia</span>
						<span class="status-tag" style="background: var(--color-brand); color: #fff;">Disponível</span>
					</h2>
					<div class="placeholder-banner">
						<h3>Transparência e Rastreabilidade</h3>
						<p>
							Entenda a escala documental de A a E, os níveis de relevância institucional de 1 a 5, as regras de elegibilidade métrica da rede e nossa política de contraditório e retificações.
						</p>
						<a href="/metodologia" class="btn btn-secondary" style="display: inline-block; margin-top: 0.75rem;">
							Ver Metodologia Completa &rarr;
						</a>
					</div>
				</section>
			</main>
			<footer class="site-footer">
				<p>VorcaroZAP &bull; Base investigativa e documental independente &bull; <a href="/metodologia" style="color: inherit; text-decoration: underline;">Metodologia e Fontes</a></p>
			</footer>
		</body>
	</html>
}
