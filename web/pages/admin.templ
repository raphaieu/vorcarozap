package pages

import (
	"fmt"
	"github.com/raphaieu/vorcarozap/web/components"
)

templ Admin(vm AdminDashboardVM) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Painel de controle e inspeção administrativa do VorcaroZAP."/>
			<title>Dashboard — Painel Administrativo — VorcaroZAP</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body>
			@components.AdminNav("dashboard")
			<main class="container">
				<section class="card" aria-label="Visão Geral Administrativa">
					<header style="margin-bottom: 1.25rem;">
						<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.5rem;">
							<h1 class="page-title" style="margin: 0;">Dashboard Administrativo</h1>
							<span class="badge" style="background-color: var(--color-badge-bg); color: var(--color-badge-text);">Autenticado</span>
						</div>
						<p class="page-subtitle" style="margin: 0; color: var(--color-text-muted);">
							Visão operacional consolidada e contagens de entidades, fontes, alegações e candidatos descobertos.
						</p>
					</header>

					<div class="editorial-notice" style="margin-bottom: 1.5rem;" aria-label="Aviso de Escopo VZ-015">
						<strong>Área Somente Leitura (Fase VZ-015)</strong>
						<p style="margin-top: 0.35rem;">
							O painel opera em modo estritamente consultivo para pesquisa, auditoria e inspeção de dados de monitoramento, fontes e evidências (inclusive registros em quarentena). Ações de moderação transacional (desaprovação, restauração e aprovação) pertencem às etapas VZ-016 e VZ-021.
						</p>
					</div>

					<div class="admin-dashboard-grid">
						<!-- Card Candidatos -->
						<div class="admin-summary-card">
							<div class="admin-summary-header">
								<h2 class="admin-summary-title">Candidatos de Monitoramento</h2>
								<a href="/admin/candidatos" class="btn btn-secondary btn-sm">Listar Candidatos &rarr;</a>
							</div>
							<div class="metrics-grid" style="grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));">
								<div class="metric-box">
									<div class="metric-label">Total</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.TotalCandidates) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #ffc107;">
									<div class="metric-label">Quarentena</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.CandidatesQuarantined) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #198754;">
									<div class="metric-label">Publicados</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.CandidatesPublished) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #dc3545;">
									<div class="metric-label">Rejeitados</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.CandidatesRejected) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #6c757d;">
									<div class="metric-label">Duplicatas</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.CandidatesDuplicates) }</div>
								</div>
							</div>
						</div>

						<!-- Card Usos de Evidência -->
						<div class="admin-summary-card">
							<div class="admin-summary-header">
								<h2 class="admin-summary-title">Usos de Evidência (Evidence Sources)</h2>
								<a href="/admin/evidencias" class="btn btn-secondary btn-sm">Listar Evidências &rarr;</a>
							</div>
							<div class="metrics-grid" style="grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));">
								<div class="metric-box">
									<div class="metric-label">Total Usos</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.TotalEvidenceSources) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #198754;">
									<div class="metric-label">Ativos</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.EvidenceSourcesActive) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #dc3545;">
									<div class="metric-label">Desaprovados</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.EvidenceSourcesRejected) }</div>
								</div>
								<div class="metric-box">
									<div class="metric-label">Claims Totais</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.TotalClaims) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #198754;">
									<div class="metric-label">Claims Publicados</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.ClaimsPublished) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #ffc107;">
									<div class="metric-label">Claims Quarentena</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.ClaimsQuarantined) }</div>
								</div>
							</div>
						</div>

						<!-- Card Fontes Documentais -->
						<div class="admin-summary-card">
							<div class="admin-summary-header">
								<h2 class="admin-summary-title">Fontes Documentais (Sources)</h2>
								<a href="/admin/fontes" class="btn btn-secondary btn-sm">Listar Fontes &rarr;</a>
							</div>
							<div class="metrics-grid" style="grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));">
								<div class="metric-box">
									<div class="metric-label">Total Fontes</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.TotalSources) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #198754;">
									<div class="metric-label">Acessíveis</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.SourcesReachable) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #dc3545;">
									<div class="metric-label">Inacessíveis</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.SourcesUnreachable) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #0d6efd;">
									<div class="metric-label">Citadas Provedor</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.SourcesCitedByProvider) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #6c757d;">
									<div class="metric-label">Não Verificadas</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.SourcesNotChecked) }</div>
								</div>
							</div>
						</div>

						<!-- Card Execuções e Base -->
						<div class="admin-summary-card">
							<div class="admin-summary-header">
								<h2 class="admin-summary-title">Execuções de Monitoramento & Base</h2>
								<span class="status-tag">Status Operacional</span>
							</div>
							<div class="metrics-grid" style="grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));">
								<div class="metric-box">
									<div class="metric-label">Entidades Cadastradas</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.TotalEntities) }</div>
								</div>
								<div class="metric-box">
									<div class="metric-label">Total Runs</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.TotalRuns) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #198754;">
									<div class="metric-label">Runs Concluídos</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.RunsCompleted) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #ffc107;">
									<div class="metric-label">Runs Parciais</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.RunsPartial) }</div>
								</div>
								<div class="metric-box" style="border-left: 3px solid #dc3545;">
									<div class="metric-label">Runs Falhos</div>
									<div class="metric-value">{ fmt.Sprintf("%d", vm.RunsFailed) }</div>
								</div>
							</div>
						</div>
					</div>
				</section>
			</main>
		</body>
	</html>
}
