package pages

import (
	"fmt"
	"github.com/raphaieu/vorcarozap/web/components"
)

templ ManifestationForm(vm ManifestationFormVM) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Submissão pública de manifestação de defesa, contraditório ou retificação documental no VorcaroZAP."/>
			<title>Apresentar Manifestação / Contraditório — VorcaroZAP</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body>
			@components.Header()
			<main class="container">
				<!-- Navegação e Voltar -->
				<nav class="breadcrumb-nav" aria-label="Navegação estrutural">
					if vm.EntitySlug != "" {
						<a href={ templ.SafeURL("/pessoas/" + vm.EntitySlug) } class="back-link">&larr; Voltar para { vm.EntityName }</a>
					} else {
						<a href="/pessoas" class="back-link">&larr; Voltar para Pessoas e Organizações</a>
					}
				</nav>

				<!-- Mensagens Flash -->
				if vm.FlashMessage != "" {
					<div class="alert alert-success" role="alert" style="margin-bottom: 1.5rem; padding: 1.25rem; border-radius: 6px; background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc;">
						<h3 style="margin-top: 0; margin-bottom: 0.5rem; font-size: 1.1rem;">Manifestação Recebida com Sucesso</h3>
						<p style="margin: 0;">{ vm.FlashMessage }</p>
					</div>
				}
				if vm.FlashError != "" {
					<div class="alert alert-danger" role="alert" style="margin-bottom: 1.5rem; padding: 1rem; border-radius: 6px; background-color: #f8d7da; color: #842029; border: 1px solid #f5c2c7;">
						<strong>Atenção:</strong> { vm.FlashError }
					</div>
				}

				if vm.IsSuccess {
					<div class="card" style="text-align: center; padding: 2.5rem 1.5rem;">
						<h2 style="color: #0f5132; margin-top: 0;">Sua manifestação foi registrada com sucesso!</h2>
						<p style="font-size: 1.05rem; color: var(--color-text-muted); max-width: 600px; margin: 1rem auto;">
							Conforme nossa política editorial e o compromisso com a integridade das informações, todas as manifestações submetidas entram imediatamente em <strong>quarentena</strong> para conferência e validação pela equipe editorial antes de qualquer divulgação pública.
						</p>
						<div style="margin-top: 2rem;">
							if vm.EntitySlug != "" {
								<a href={ templ.SafeURL("/pessoas/" + vm.EntitySlug) } class="btn btn-primary">Retornar à página de { vm.EntityName }</a>
							} else {
								<a href="/pessoas" class="btn btn-primary">Retornar à listagem de Pessoas</a>
							}
						</div>
					</div>
				} else {
					<!-- Aviso Editorial e de Quarentena -->
					<section class="editorial-notice" aria-label="Aviso sobre Contraditório">
						<strong>Canal de Contraditório e Ampla Defesa</strong>
						<p>
							O VorcaroZAP assegura a todas as pessoas e organizações mencionadas o direito ao contraditório, à retificação factual e à contextualização de informações.
							<strong>Nenhuma manifestação é publicada automaticamente</strong>: toda submissão passa por verificação humana prévia para validação documental e proteção contra abusos.
						</p>
					</section>

					<!-- Contexto da Alegação -->
					if vm.ClaimProposition != "" {
						<section class="card" style="margin-bottom: 1.5rem; border-left: 4px solid var(--color-primary);">
							<span class="fact-label">Alegação / Fato Objeto da Manifestação:</span>
							<h2 style="font-size: 1.2rem; margin: 0.35rem 0 0.5rem 0;">{ vm.ClaimProposition }</h2>
							if vm.EntityName != "" {
								<span style="font-size: 0.9rem; color: var(--color-text-muted);">
									Entidade Relacionada: <strong>{ vm.EntityName }</strong>
								</span>
							}
						</section>
					}

					<!-- Formulário de Submissão -->
					<section class="card" aria-label="Formulário de Manifestação">
						<h1 class="page-title" style="font-size: 1.4rem; margin-top: 0; margin-bottom: 0.5rem;">
							Apresentar Manifestação, Defesa ou Retificação
						</h1>
						<p style="color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
							Preencha os campos abaixo de forma objetiva. Dados de contato são confidenciais e nunca serão exibidos publicamente.
						</p>

						<form method="POST" action="/manifestar" style="display: flex; flex-direction: column; gap: 1.25rem;">
							<input type="hidden" name="claim_id" value={ vm.ClaimID }/>

							<!-- Tipo de Manifestação -->
							<div class="form-group">
								<label for="statement_type" class="form-label">
									<strong>Tipo de Manifestação *</strong>
								</label>
								<select id="statement_type" name="statement_type" class="form-control" required style="width: 100%; padding: 0.5rem;">
									for _, opt := range vm.StatementTypes {
										<option value={ opt.Value }>{ fmt.Sprintf("%s — %s", opt.Label, opt.Description) }</option>
									}
								</select>
							</div>

							<!-- Título Curto -->
							<div class="form-group">
								<label for="title" class="form-label">
									<strong>Título da Manifestação *</strong>
								</label>
								<input
									type="text"
									id="title"
									name="title"
									class="form-control"
									required
									maxlength="200"
									placeholder="Ex: Nota oficial de esclarecimento da defesa técnica..."
									style="width: 100%; padding: 0.5rem;"
								/>
								<span style="font-size: 0.8rem; color: var(--color-text-muted);">Máximo de 200 caracteres. Não utilize tags HTML.</span>
							</div>

							<!-- Texto / Conteúdo -->
							<div class="form-group">
								<label for="content" class="form-label">
									<strong>Texto Completo da Manifestação / Contraditório *</strong>
								</label>
								<textarea
									id="content"
									name="content"
									class="form-control"
									rows="6"
									required
									minlength="10"
									maxlength="5000"
									placeholder="Descreva detalhadamente seus esclarecimentos, correções factuais ou argumentos de defesa (mínimo 10 caracteres, máximo 5.000 caracteres)..."
									style="width: 100%; padding: 0.5rem; resize: vertical;"
								></textarea>
								<span style="font-size: 0.8rem; color: var(--color-text-muted);">Texto puro. Tags HTML ou scripts serão rejeitados.</span>
							</div>

							<!-- URL de Referência / Fonte Oficial -->
							<div class="form-group">
								<label for="source_url" class="form-label">
									<strong>Link da Fonte / Documento Oficial (Opcional)</strong>
								</label>
								<input
									type="url"
									id="source_url"
									name="source_url"
									class="form-control"
									maxlength="1000"
									placeholder="https://exemplo.com/documento-ou-comunicado.pdf"
									style="width: 100%; padding: 0.5rem;"
								/>
								<span style="font-size: 0.8rem; color: var(--color-text-muted);">URL completa iniciando com http:// ou https://.</span>
							</div>

							<!-- Dados de Contato (Privado) -->
							<div class="form-group" style="background-color: var(--color-bg-subtle, #f9f9f9); padding: 1rem; border-radius: 6px; border: 1px solid var(--color-border);">
								<label for="contact_info" class="form-label">
									<strong>Identificação e Contato do Declarante (Opcional & Estritamente Privado)</strong>
								</label>
								<input
									type="text"
									id="contact_info"
									name="contact_info"
									class="form-control"
									maxlength="255"
									placeholder="Ex: Dr. Fulano de Tal (OAB/SP 123.456) - email@advocacia.com - (11) 9999-9999"
									style="width: 100%; padding: 0.5rem;"
								/>
								<span style="font-size: 0.8rem; color: #842029; font-weight: 500; display: block; margin-top: 0.25rem;">
									&bull; Sigilo Absoluto: Este campo é confidencial e NUNCA será exibido publicamente na plataforma.
								</span>
							</div>

							<!-- Botão de Envio -->
							<div style="margin-top: 1rem;">
								<button type="submit" class="btn btn-primary" style="padding: 0.75rem 1.5rem; font-size: 1rem;">
									Enviar Manifestação para Análise Editorial
								</button>
							</div>
						</form>
					</section>
				}
			</main>
			<footer class="site-footer">
				<p>VorcaroZAP &bull; Base investigativa e documental independente &bull; <a href="/metodologia" style="color: inherit; text-decoration: underline;">Metodologia e Escala A–E</a></p>
			</footer>
		</body>
	</html>
}
