package pages

import (
	"fmt"
	"github.com/raphaieu/vorcarozap/web/components"
)

templ AdminManifestationDetail(vm AdminDefenseStatementDetailVM) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Inspeção e moderação de manifestação de defesa e contraditório no VorcaroZAP."/>
			<title>{ "Moderação: " + vm.Title } — Admin — VorcaroZAP</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body>
			@components.AdminNav("manifestacoes")
			<main class="container">
				<!-- Navegação de Retorno -->
				<div class="breadcrumb-nav">
					<a href="/admin/manifestacoes" class="back-link">&larr; Voltar para listagem de manifestações</a>
				</div>

				<!-- Mensagens Flash -->
				if vm.FlashMessage != "" {
					<div class="alert alert-success" role="alert" style="margin-bottom: 1.5rem; padding: 1rem; border-radius: 6px; background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc;">
						<strong>Sucesso:</strong> { vm.FlashMessage }
					</div>
				}
				if vm.FlashError != "" {
					<div class="alert alert-danger" role="alert" style="margin-bottom: 1.5rem; padding: 1rem; border-radius: 6px; background-color: #f8d7da; color: #842029; border: 1px solid #f5c2c7;">
						<strong>Atenção:</strong> { vm.FlashError }
					</div>
				}

				<!-- Cabeçalho da Manifestação -->
				<section class="card admin-detail-header-card" aria-label="Dados Principais da Manifestação">
					<div class="admin-detail-title-row">
						<div>
							<span class="category-badge" style="margin-bottom: 0.5rem; display: inline-block;">
								{ vm.StatementTypeHuman }
							</span>
							<h1 class="page-title" style="margin-bottom: 0.25rem; font-size: 1.4rem;">
								{ vm.Title }
							</h1>
							<p class="page-subtitle" style="margin: 0;">
								ID: <code>{ vm.ID }</code> &bull; Submetida em: <strong>{ vm.CreatedAtHuman }</strong> &bull; Atualizada em: <strong>{ vm.UpdatedAtHuman }</strong>
							</p>
						</div>
						<div class="badge-cluster">
							if vm.Status == "quarantined" {
								<span class="admin-status-badge status-quarantined">{ vm.StatusHuman }</span>
							} else if vm.Status == "under_review" {
								<span class="admin-status-badge status-archived">{ vm.StatusHuman }</span>
							} else if vm.Status == "accepted" {
								<span class="admin-status-badge status-published">{ vm.StatusHuman }</span>
							} else if vm.Status == "rejected" {
								<span class="admin-status-badge status-rejected">{ vm.StatusHuman }</span>
							} else {
								<span class="admin-status-badge status-archived">{ vm.StatusHuman }</span>
							}
						</div>
					</div>

					<!-- Texto da Manifestação -->
					<div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-border);">
						<span class="fact-label">Texto da Manifestação / Contraditório:</span>
						<blockquote class="source-excerpt" style="font-size: 0.95rem; line-height: 1.5; margin-top: 0.5rem; background-color: #fff; border: 1px solid var(--color-border); border-radius: 4px; padding: 1rem;">
							{ vm.Content }
						</blockquote>
					</div>

					if vm.SourceURL != "" {
						<div style="margin-top: 0.75rem;">
							<span class="fact-label">Fonte / Documento Comprobatório Informado:</span>
							<div style="margin-top: 0.25rem;">
								<a href={ templ.SafeURL(vm.SourceURL) } target="_blank" rel="noopener noreferrer" class="source-external-link">
									{ vm.SourceURL } &nearr;
								</a>
							</div>
						</div>
					}

					<!-- Dados de Contato Privados -->
					<div style="margin-top: 1rem; padding: 1rem; background-color: #fff3cd; border: 1px solid #ffe69c; border-radius: 6px;">
						<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.25rem;">
							<span style="font-weight: 700; color: #664d03; font-size: 0.85rem; text-transform: uppercase;">
								Dado Privado de Contato (Exclusivo da Equipe Editorial)
							</span>
							<span class="badge" style="background-color: #ffc107; color: #000; font-size: 0.75rem;">Confidencial</span>
						</div>
						if vm.ContactInfo != "" {
							<p style="margin: 0; font-size: 0.95rem; color: #332701; font-weight: 500;">{ vm.ContactInfo }</p>
						} else {
							<p style="margin: 0; font-size: 0.85rem; color: #664d03; font-style: italic;">Nenhum dado de contato foi informado pelo declarante.</p>
						}
					</div>
				</section>

				<!-- Alegação Vinculada -->
				<section class="card" aria-label="Alegação Objeto da Manifestação">
					<div class="admin-summary-header" style="margin-bottom: 0.75rem;">
						<h2 class="card-title" style="margin: 0;">Alegação Vinculada</h2>
						<a href={ templ.SafeURL("/admin/claims/" + vm.ClaimID) } class="dist-filter-link">
							Ver detalhes da alegação &rarr;
						</a>
					</div>
					<div class="admin-detail-facts-grid">
						<div class="fact-item fact-full">
							<span class="fact-label">Proposição</span>
							<span class="fact-value" style="font-size: 1.05rem; font-weight: 600;">{ vm.ClaimProposition }</span>
						</div>
						<div class="fact-item">
							<span class="fact-label">Entidade Sujeito</span>
							<span class="fact-value"><strong>{ vm.SubjectEntityName }</strong></span>
						</div>
						<div class="fact-item">
							<span class="fact-label">Classificação da Alegação</span>
							<span class="fact-value">{ vm.ClaimGradeHuman }</span>
						</div>
						<div class="fact-item">
							<span class="fact-label">Estado da Alegação</span>
							<span class="fact-value">{ vm.ClaimStatusHuman }</span>
						</div>
					</div>
				</section>

				<!-- Painel de Moderação Editorial -->
				<section class="card" aria-label="Painel de Moderação Editorial">
					<h2 class="card-title">Deliberação Editorial & Moderação Humana</h2>

					if len(vm.AllowedActions) == 0 {
						<p class="admin-reasons-empty">
							Nenhuma ação de transição permitida no momento para o estado <strong>{ vm.StatusHuman }</strong>.
						</p>
					} else {
						<form method="POST" action={ templ.SafeURL("/admin/manifestacoes/" + vm.ID + "/moderate") } style="margin-top: 1rem;">
							<input type="hidden" name="expected_updated_at" value={ vm.UpdatedAtRaw }/>
							<div class="form-group" style="margin-bottom: 1.25rem;">
								<label for="moderation-reason" class="form-label">
									<strong>Justificativa Fundamentada (Obrigatória) *</strong>
								</label>
								<textarea
									id="moderation-reason"
									name="reason"
									class="form-control"
									rows="3"
									required
									maxlength="1000"
									placeholder="Descreva detalhadamente o motivo editorial desta deliberação (mínimo 1 caractere, máximo 1000 caracteres, sem tags HTML)..."
									style="width: 100%; resize: vertical;"
								></textarea>
								<span style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.25rem; display: block;">
									A justificativa e o operador autenticado serão gravados permanentemente no histórico auditável imutável.
								</span>
							</div>

							<div style="display: flex; flex-direction: column; gap: 1rem;">
								for _, act := range vm.AllowedActions {
									<div style="display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: 6px; background-color: var(--color-bg-subtle, #fcfcfc);">
										<div style="flex-shrink: 0;">
											if act.Disabled {
												<button
													type="button"
													class={ "btn", act.ButtonClass }
													disabled
													style="opacity: 0.6; cursor: not-allowed;"
												>
													{ act.Label }
												</button>
											} else {
												<button
													type="submit"
													name="action"
													value={ act.Action }
													class={ "btn", act.ButtonClass }
													onclick="return confirm('Confirma a execução desta deliberação sobre a manifestação?');"
												>
													{ act.Label }
												</button>
											}
										</div>
										<div style="flex-grow: 1;">
											<div style="font-weight: 600; font-size: 0.95rem; margin-bottom: 0.25rem;">
												{ act.Label }
											</div>
											<div style="font-size: 0.85rem; color: var(--color-text-muted);">
												{ act.HelpText }
											</div>
										</div>
									</div>
								}
							</div>
						</form>
					}
				</section>

				<!-- Histórico de Decisões de Moderação -->
				<section class="card" aria-label="Histórico de Auditoria da Manifestação">
					<div class="admin-summary-header" style="margin-bottom: 0.75rem;">
						<div>
							<h2 class="card-title" style="margin: 0;">
								Histórico de Deliberações ({ fmt.Sprintf("%d", len(vm.Decisions)) })
							</h2>
							<span style="font-size: 0.8rem; color: var(--color-text-muted);">Trilha administrativa completa e irredigida (restrita a operadores autenticados).</span>
						</div>
						<div class="badge-cluster">
							<span class="status-tag">Imutável</span>
						</div>
					</div>

					if len(vm.Decisions) == 0 {
						<p class="admin-reasons-empty">Nenhuma decisão de moderação registrada para esta manifestação até o momento.</p>
					} else {
						<div class="table-responsive">
							<table class="table admin-table">
								<thead>
									<tr>
										<th>Data UTC</th>
										<th>Ação</th>
										<th>Operador (Actor)</th>
										<th>Justificativa (Reason)</th>
									</tr>
								</thead>
								<tbody>
									for _, d := range vm.Decisions {
										<tr>
											<td style="white-space: nowrap; font-size: 0.85rem;">
												{ d.CreatedAtHuman }
											</td>
											<td>
												if d.Action == "accept" {
													<span class="admin-status-badge status-published">{ d.ActionHuman }</span>
												} else if d.Action == "reject" {
													<span class="admin-status-badge status-rejected">{ d.ActionHuman }</span>
												} else if d.Action == "review" {
													<span class="admin-status-badge status-archived">{ d.ActionHuman }</span>
												} else {
													<span class="admin-status-badge status-quarantined">{ d.ActionHuman }</span>
												}
											</td>
											<td>
												<strong>{ d.Actor }</strong>
											</td>
											<td style="max-width: 450px; word-break: break-word;">
												{ d.Reason }
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</section>
			</main>
		</body>
	</html>
}
