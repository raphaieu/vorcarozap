package pages

import (
	"fmt"
	"github.com/raphaieu/vorcarozap/web/components"
)

templ AdminClaimDetail(vm AdminClaimDetailVM) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Inspeção e moderação detalhada de alegação (claim) no VorcaroZAP."/>
			<title>{ "Moderação: " + vm.Proposition } — Admin — VorcaroZAP</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body>
			@components.AdminNav("evidencias")
			<main class="container">
				<!-- Navegação de Retorno -->
				<div class="breadcrumb-nav">
					<a href="/admin/evidencias" class="back-link">&larr; Voltar para listagem de evidências</a>
				</div>

				<!-- Mensagens Flash -->
				if vm.FlashMessage != "" {
					<div class="alert alert-success" role="alert" style="margin-bottom: 1.5rem; padding: 1rem; border-radius: 6px; background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc;">
						<strong>Sucesso:</strong> { vm.FlashMessage }
					</div>
				}
				if vm.FlashError != "" {
					<div class="alert alert-danger" role="alert" style="margin-bottom: 1.5rem; padding: 1rem; border-radius: 6px; background-color: #f8d7da; color: #842029; border: 1px solid #f5c2c7;">
						<strong>Atenção:</strong> { vm.FlashError }
					</div>
				}

				<!-- Cabeçalho do Claim -->
				<section class="card admin-detail-header-card" aria-label="Dados Principais da Alegação">
					<div class="admin-detail-title-row">
						<div>
							<span class="category-badge" style="margin-bottom: 0.5rem; display: inline-block;">
								{ vm.RelationshipType }
							</span>
							<h1 class="page-title" style="margin-bottom: 0.25rem; font-size: 1.5rem;">
								{ vm.Proposition }
							</h1>
							<p class="page-subtitle" style="margin: 0;">
								ID: <code>{ vm.ID }</code> &bull; Criado em: <strong>{ vm.CreatedAtHuman }</strong> &bull; Atualizado em: <strong>{ vm.UpdatedAtHuman }</strong>
							</p>
						</div>
						<div class="badge-cluster">
							<span class={ "grade-badge", "grade-" + vm.Grade }>
								{ vm.GradeHuman }
							</span>
							if vm.Status == "published" {
								<span class="admin-status-badge status-published">Publicado</span>
							} else if vm.Status == "quarantined" {
								<span class="admin-status-badge status-quarantined">Quarentena (Não público)</span>
							} else if vm.Status == "rejected" {
								<span class="admin-status-badge status-rejected">Rejeitado</span>
							} else {
								<span class="admin-status-badge status-archived">Arquivado</span>
							}

							if vm.MetricEligible {
								<span class="status-tag" style="background-color: #d1e7dd; color: #0f5132;">Conta em Métricas</span>
							} else {
								<span class="status-tag" style="background-color: #e2e3e5; color: #41464b;">Fora das Métricas</span>
							}
						</div>
					</div>

					<div class="admin-detail-facts-grid">
						<div class="fact-item">
							<span class="fact-label">Origem Editorial</span>
							<span class="fact-value"><strong>{ vm.OriginHuman }</strong></span>
						</div>
						<div class="fact-item">
							<span class="fact-label">Disposição Probatória</span>
							<span class="fact-value">{ vm.DispositionHuman }</span>
						</div>
						<div class="fact-item">
							<span class="fact-label">Suportes Ativos (supports)</span>
							<span class="fact-value">
								if vm.ActiveSupportsCount > 0 {
									<strong style="color: #0f5132;">{ fmt.Sprintf("%d", vm.ActiveSupportsCount) } ativos</strong>
								} else {
									<strong style="color: #842029;">0 ativos (sem suporte)</strong>
								}
							</span>
						</div>
						<div class="fact-item">
							<span class="fact-label">Entidade Sujeito</span>
							<span class="fact-value">
								if vm.SubjectEntityName != "" {
									<strong>{ vm.SubjectEntityName }</strong>
									if vm.SubjectEntitySlug != "" {
										<span style="font-size: 0.8rem; color: var(--color-text-muted); display: block;">Slug: { vm.SubjectEntitySlug }</span>
									}
								} else {
									<span style="color: var(--color-text-muted);">Não identificada</span>
								}
							</span>
						</div>
						<div class="fact-item">
							<span class="fact-label">Entidade-Alvo / Caso</span>
							<span class="fact-value">
								if vm.TargetEntityName != "" {
									<strong>{ vm.TargetEntityName }</strong>
									if vm.TargetEntitySlug != "" {
										<span style="font-size: 0.8rem; color: var(--color-text-muted); display: block;">Slug: { vm.TargetEntitySlug }</span>
									}
								} else if vm.CaseName != "" {
									<strong>{ vm.CaseName }</strong>
									if vm.CaseSlug != "" {
										<span style="font-size: 0.8rem; color: var(--color-text-muted); display: block;">Caso: { vm.CaseSlug }</span>
									}
								} else {
									<span style="color: var(--color-text-muted);">Geral / Sem alvo</span>
								}
							</span>
						</div>
						<div class="fact-item">
							<span class="fact-label">Candidato Associado</span>
							<span class="fact-value">
								if vm.CandidateID != "" {
									<a href={ templ.SafeURL("/admin/candidatos/" + vm.CandidateID) } class="dist-filter-link">
										<code>{ vm.CandidateID }</code> &rarr;
									</a>
								} else {
									<span style="color: var(--color-text-muted);">Origem direta (sem candidato)</span>
								}
							</span>
						</div>
					</div>

					if vm.Attribution != "" || vm.RelationshipContextLimits != "" {
						<div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-border);">
							if vm.Attribution != "" {
								<div style="margin-bottom: 0.5rem;">
									<span class="fact-label">Atribuição / Sujeito</span>
									<p style="margin: 0.25rem 0 0 0;">{ vm.Attribution }</p>
								</div>
							}
							if vm.RelationshipContextLimits != "" {
								<div>
									<span class="fact-label">Limites de Contexto da Relação</span>
									<p style="margin: 0.25rem 0 0 0; color: var(--color-text-muted);">{ vm.RelationshipContextLimits }</p>
								</div>
							}
						</div>
					}
				</section>

				<!-- Painel de Moderação Humana -->
				<section class="card" aria-label="Painel de Moderação Humana">
					<h2 class="card-title">Deliberação Editorial & Moderação Humana</h2>

					if len(vm.AllowedActions) == 0 {
						<p class="admin-reasons-empty">
							Nenhuma ação de transição permitida no momento para o estado <strong>{ vm.StatusHuman }</strong>.
						</p>
					} else {
						<form method="POST" action={ templ.SafeURL("/admin/claims/" + vm.ID + "/moderate") } style="margin-top: 1rem;">
							<input type="hidden" name="expected_updated_at" value={ vm.UpdatedAtRaw }/>
							<div class="form-group" style="margin-bottom: 1.25rem;">
								<label for="moderation-reason" class="form-label">
									<strong>Justificativa Fundamentada (Obrigatória) *</strong>
								</label>
								<textarea
									id="moderation-reason"
									name="reason"
									class="form-control"
									rows="3"
									required
									maxlength="1000"
									placeholder="Descreva detalhadamente o motivo editorial desta deliberação (mínimo 1 caractere, máximo 1000 caracteres, sem tags HTML)..."
									style="width: 100%; resize: vertical;"
								></textarea>
								<span style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.25rem; display: block;">
									A justificativa e o operador autenticado serão gravados permanentemente na tabela auditável de decisões de moderação.
								</span>
							</div>

							<div style="display: flex; flex-direction: column; gap: 1rem;">
								for _, act := range vm.AllowedActions {
									<div style="display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: 6px; background-color: var(--color-bg-subtle, #fcfcfc);">
										<div style="flex-shrink: 0;">
											if act.Disabled {
												<button
													type="button"
													class={ "btn", act.ButtonClass }
													disabled
													style="opacity: 0.6; cursor: not-allowed;"
												>
													{ act.Label }
												</button>
											} else {
												<button
													type="submit"
													name="action"
													value={ act.Action }
													class={ "btn", act.ButtonClass }
													onclick="return confirm('Confirma a execução desta ação de moderação editorial?');"
												>
													{ act.Label }
												</button>
											}
										</div>
										<div style="flex-grow: 1;">
											<div style="font-weight: 600; font-size: 0.95rem; margin-bottom: 0.25rem;">
												{ act.Label }
											</div>
											<div style="font-size: 0.85rem; color: var(--color-text-muted);">
												{ act.HelpText }
											</div>
											if act.Disabled && act.DisabledReason != "" {
												<div style="font-size: 0.85rem; color: #842029; margin-top: 0.25rem; font-weight: 600;">
													&times; { act.DisabledReason }
												</div>
											}
										</div>
									</div>
								}
							</div>
						</form>
					}
				</section>

				<!-- Usos de Evidência Associados -->
				<section class="card" aria-label="Usos de Evidência Associados">
					<div class="admin-summary-header" style="margin-bottom: 0.75rem;">
						<h2 class="card-title" style="margin: 0;">
							Usos de Evidência Associados ({ fmt.Sprintf("%d", len(vm.EvidenceSources)) })
						</h2>
						<span class="status-tag">Documentação Probatória</span>
					</div>

					if len(vm.EvidenceSources) == 0 {
						<p class="admin-reasons-empty">Nenhum uso de evidência vinculado a esta alegação.</p>
					} else {
						<div class="admin-candidate-list">
							for _, es := range vm.EvidenceSources {
								<div class="admin-item-card">
									<div class="admin-item-header">
										<div>
											<span class="admin-item-id">EvidenceSource: <a href={ templ.SafeURL("/admin/evidencias/" + es.EvidenceSourceID) } class="dist-filter-link"><code>{ es.EvidenceSourceID }</code> &rarr;</a></span>
											<div style="font-size: 0.85rem; color: var(--color-text-muted); margin-top: 0.25rem;">
												Tipo de Evidência: <strong>{ es.EvidenceType }</strong> &bull; Criado em: { es.EvidenceSourceCreatedHuman }
											</div>
										</div>
										<div class="badge-cluster">
											if es.Role == "supports" {
												<span class="admin-status-badge status-published">{ es.RoleHuman }</span>
											} else if es.Role == "contradicts" {
												<span class="admin-status-badge status-quarantined">{ es.RoleHuman }</span>
											} else {
												<span class="admin-status-badge status-archived">{ es.RoleHuman }</span>
											}

											if es.EvidenceSourceStatus == "active" {
												<span class="status-tag" style="background-color: #d1e7dd; color: #0f5132;">Uso Ativo</span>
											} else {
												<span class="status-tag" style="background-color: #f8d7da; color: #842029;">Uso Desaprovado</span>
											}
										</div>
									</div>

									<div class="admin-item-body">
										if es.EvidenceSummary != "" {
											<div style="margin-bottom: 0.5rem;">
												<span class="fact-label">Resumo Probatório</span>
												<p style="margin: 0.25rem 0;">{ es.EvidenceSummary }</p>
											</div>
										}

										if es.Excerpt != "" {
											<div class="source-excerpt">
												&ldquo;{ es.Excerpt }&rdquo;
												if es.Locator != "" {
													<span class="source-locator">{ es.Locator }</span>
												}
											</div>
										}

										<div class="admin-item-source-info">
											<span class="meta-item">
												Fonte:
												if es.SourceTitle != "" {
													<strong>{ es.SourceTitle }</strong>
												}
												if es.SourcePublisher != "" {
													<span>({ es.SourcePublisher })</span>
												}
											</span>
											<span class="meta-item">
												Tipo: <strong>{ es.SourceType }</strong>
											</span>
											<span class="meta-item">
												Acessibilidade: <strong>{ es.SourceAccessStatusHuman }</strong>
											</span>
											if es.SourceCanonicalURL.IsValid {
												<span class="meta-item">
													<a
														href={ templ.SafeURL(es.SourceCanonicalURL.SafeURL) }
														target="_blank"
														rel="noopener noreferrer"
														class="source-external-link"
													>
														Abrir Fonte Canônica &nearr;
													</a>
												</span>
											}
										</div>
									</div>
								</div>
							}
						</div>
					}
				</section>

				<!-- Histórico de Decisões de Moderação -->
				<section class="card" aria-label="Histórico de Auditoria de Moderação">
					<div class="admin-summary-header" style="margin-bottom: 0.75rem;">
						<h2 class="card-title" style="margin: 0;">
							Histórico de Decisões de Moderação ({ fmt.Sprintf("%d", len(vm.Decisions)) })
						</h2>
						<span class="status-tag">Auditoria Imutável</span>
					</div>

					if len(vm.Decisions) == 0 {
						<p class="admin-reasons-empty">Nenhuma decisão de moderação registrada para esta alegação.</p>
					} else {
						<div class="table-responsive">
							<table class="table admin-table">
								<thead>
									<tr>
										<th>Data UTC</th>
										<th>Ação</th>
										<th>Operador (Actor)</th>
										<th>Justificativa (Reason)</th>
										<th>Fingerprint Preservado</th>
									</tr>
								</thead>
								<tbody>
									for _, d := range vm.Decisions {
										<tr>
											<td style="white-space: nowrap; font-size: 0.85rem;">
												{ d.CreatedAtHuman }
											</td>
											<td>
												if d.Action == "approve" {
													<span class="admin-status-badge status-published">{ d.ActionHuman }</span>
												} else if d.Action == "reject" {
													<span class="admin-status-badge status-rejected">{ d.ActionHuman }</span>
												} else if d.Action == "restore" {
													<span class="admin-status-badge status-quarantined">{ d.ActionHuman }</span>
												} else {
													<span class="admin-status-badge status-archived">{ d.ActionHuman }</span>
												}
											</td>
											<td>
												<strong>{ d.Actor }</strong>
											</td>
											<td style="max-width: 400px; word-break: break-word;">
												{ d.Reason }
											</td>
											<td>
												if d.CandidateFingerprint != "" {
													<code style="font-size: 0.75rem; word-break: break-all;">{ d.CandidateFingerprint }</code>
												} else {
													<span style="color: var(--color-text-muted);">&mdash;</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</section>
			</main>
		</body>
	</html>
}
