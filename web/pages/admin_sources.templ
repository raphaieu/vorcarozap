package pages

import (
	"fmt"
	"github.com/raphaieu/vorcarozap/web/components"
)

templ AdminSources(vm AdminSourceListVM) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Listagem e inspeção de fontes documentais no VorcaroZAP."/>
			<title>Fontes Documentais — Admin — VorcaroZAP</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body>
			@components.AdminNav("fontes")
			<main class="container">
				<!-- Cabeçalho da Página -->
				<header class="page-intro">
					<h1 class="page-title">Fontes Documentais (Sources)</h1>
					<p class="page-subtitle">
						Catálogo de publicações e documentos verificados. Fontes representam documentos reutilizáveis e não sofrem desaprovação global.
					</p>
				</header>

				<!-- Formulário de Filtros e Busca -->
				<section class="card filter-card" aria-label="Filtros de Fontes">
					<form method="GET" action="/admin/fontes" class="filter-form">
						<div class="search-row">
							<div class="form-group flex-grow">
								<label for="search-input" class="form-label">Busca Textual</label>
								<input
									type="search"
									id="search-input"
									name="q"
									class="form-control"
									placeholder="Buscar por título, veículo, autor ou URL..."
									value={ vm.Filter.Search }
								/>
							</div>
							<div class="form-actions-inline">
								<button type="submit" class="btn btn-primary">Filtrar</button>
								if vm.Filter.Search != "" || vm.Filter.AccessStatus != "" || vm.Filter.SourceType != "" || (vm.Filter.Period != "" && vm.Filter.Period != "all") {
									<a href="/admin/fontes" class="btn btn-subtle">Limpar</a>
								}
							</div>
						</div>

						<div class="filters-grid">
							<!-- Status de Acessibilidade -->
							<div class="form-group">
								<label for="filter-access-status" class="form-label">Estado de Acessibilidade</label>
								<select id="filter-access-status" name="access_status" class="form-control" onchange="this.form.submit()">
									<option value="">Todos os estados</option>
									<option value="reachable" selected?={ vm.Filter.AccessStatus == "reachable" }>Acessível (Confirmada)</option>
									<option value="unreachable" selected?={ vm.Filter.AccessStatus == "unreachable" }>Inacessível (Falha definitiva)</option>
									<option value="cited_by_provider" selected?={ vm.Filter.AccessStatus == "cited_by_provider" }>Citada pelo Provedor</option>
									<option value="not_checked" selected?={ vm.Filter.AccessStatus == "not_checked" }>Não Verificada</option>
								</select>
							</div>

							<!-- Tipo de Fonte -->
							<div class="form-group">
								<label for="filter-source-type" class="form-label">Tipo de Fonte</label>
								<select id="filter-source-type" name="source_type" class="form-control" onchange="this.form.submit()">
									<option value="">Todos os tipos</option>
									for _, opt := range vm.SourceTypeOptions {
										<option value={ opt.Value } selected?={ vm.Filter.SourceType == opt.Value }>{ opt.Label }</option>
									}
								</select>
							</div>

							<!-- Período de Criação -->
							<div class="form-group">
								<label for="filter-period" class="form-label">Período de Cadastro</label>
								<select id="filter-period" name="period" class="form-control" onchange="this.form.submit()">
									<option value="all" selected?={ vm.Filter.Period == "" || vm.Filter.Period == "all" }>Todo o histórico</option>
									<option value="7d" selected?={ vm.Filter.Period == "7d" }>Últimos 7 dias</option>
									<option value="30d" selected?={ vm.Filter.Period == "30d" }>Últimos 30 dias</option>
									<option value="90d" selected?={ vm.Filter.Period == "90d" }>Últimos 90 dias</option>
								</select>
							</div>
						</div>
					</form>
				</section>

				<!-- Cabeçalho de Resultados -->
				<div class="results-header">
					<span class="results-count">
						<strong>{ fmt.Sprintf("%d", vm.Filter.TotalCount) }</strong> fontes encontradas
					</span>
					if vm.Filter.TotalPages > 1 {
						<span class="pagination-status">
							Página { fmt.Sprintf("%d", vm.Filter.Page) } de { fmt.Sprintf("%d", vm.Filter.TotalPages) }
						</span>
					}
				</div>

				<!-- Listagem de Fontes -->
				if len(vm.Sources) == 0 {
					<section class="card empty-state" aria-label="Nenhuma Fonte Encontrada">
						<h3>Nenhuma fonte encontrada</h3>
						<p>Nenhuma publicação corresponde aos critérios de filtro selecionados.</p>
					</section>
				} else {
					<div class="admin-items-list" aria-label="Lista de Fontes">
						for _, s := range vm.Sources {
							<article class="card admin-item-card">
								<div class="admin-item-header">
									<div class="admin-item-title-group">
										<div class="admin-item-title-row">
											if s.Title != "" {
												<span class="admin-subject-name">{ s.Title }</span>
											} else {
												<span class="source-title-pending">[Título pendente de enriquecimento]</span>
											}
											if s.PublisherOrAuthor != "" {
												<span class="category-badge">{ s.PublisherOrAuthor }</span>
											}
											if s.SourceType != "" {
												<span class="status-tag">{ s.SourceType }</span>
											}
										</div>
										<div class="admin-item-meta-row">
											<span>ID: <code>{ s.ID }</code></span>
											if s.PublishedAtHuman != "" {
												<span>Publicado em: <strong>{ s.PublishedAtHuman }</strong></span>
											}
											<span>Cadastrado em: <strong>{ s.CreatedAtHuman }</strong></span>
										</div>
									</div>

									<div class="badge-cluster">
										if s.SourceAccessStatus == "reachable" {
											<span class="admin-status-badge status-published">Acessível</span>
										} else if s.SourceAccessStatus == "unreachable" {
											<span class="admin-status-badge status-rejected">Inacessível</span>
										} else if s.SourceAccessStatus == "cited_by_provider" {
											<span class="admin-status-badge" style="background-color: #cfe2ff; color: #084298;">Citada Provedor</span>
										} else {
											<span class="admin-status-badge status-archived">Não Verificada</span>
										}

										<span class="status-tag">
											Usos: <strong>{ fmt.Sprintf("%d", s.TotalUses) }</strong> ({ fmt.Sprintf("%d", s.ActiveUses) } ativos)
										</span>
									</div>
								</div>

								<div class="admin-item-body">
									<!-- Link externo direto -->
									<div class="admin-item-source-info">
										<span class="fact-label">URL Canônica:</span>
										if s.CanonicalURL.IsValid {
											<a
												href={ templ.SafeURL(s.CanonicalURL.SafeURL) }
												target="_blank"
												rel="noopener noreferrer"
												class="source-external-link"
												style="word-break: break-all; margin-top: 0.2rem;"
												title="Abrir URL original da fonte em nova aba"
											>
												{ s.CanonicalURL.SafeURL } &UpperRightArrow;
											</a>
										} else if s.CanonicalURL.RawURL != "" {
											<span class="source-url-invalid" title="URL externa inválida ou insegura" style="word-break: break-all; margin-top: 0.2rem; color: var(--color-text-muted);">
												{ s.CanonicalURL.RawURL } <em>(URL inválida ou insegura)</em>
											</span>
										} else {
											<span style="color: var(--color-text-muted); margin-top: 0.2rem;">Não informada</span>
										}
									</div>

									<!-- Diagnóstico de Verificação Técnica -->
									<div class="admin-detail-facts-grid" style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--color-border);">
										<div class="fact-item">
											<span class="fact-label">Última Verificação</span>
											<span class="fact-value">
												if s.SourceCheckedAtHuman != "" {
													{ s.SourceCheckedAtHuman }
												} else {
													<span style="color: var(--color-text-muted);">Não realizada</span>
												}
											</span>
										</div>
										<div class="fact-item">
											<span class="fact-label">Status HTTP</span>
											<span class="fact-value">
												if s.HTTPStatus.Valid {
													<code>{ fmt.Sprintf("%d", s.HTTPStatus.Int64) }</code>
												} else {
													<span style="color: var(--color-text-muted);">&mdash;</span>
												}
											</span>
										</div>
										<div class="fact-item">
											<span class="fact-label">Código de Erro Técnico</span>
											<span class="fact-value">
												if s.NormalizedErrorCode != "" {
													<code>{ s.NormalizedErrorCode }</code>
												} else {
													<span style="color: var(--color-text-muted);">Nenhum</span>
												}
											</span>
										</div>
									</div>
								</div>
							</article>
						}
					</div>

					<!-- Paginação com filtros preservados -->
					if vm.Filter.TotalPages > 1 {
						<nav class="pagination-nav" aria-label="Navegação entre páginas de fontes">
							if vm.Filter.Page > 1 {
								<a
									href={ templ.SafeURL("/admin/fontes" + vm.Filter.BuildQueryString(vm.Filter.Page-1)) }
									class="btn-pagination"
								>
									&larr; Anterior
								</a>
							} else {
								<span class="btn-pagination disabled">&larr; Anterior</span>
							}

							<span class="pagination-status">
								Página { fmt.Sprintf("%d", vm.Filter.Page) } de { fmt.Sprintf("%d", vm.Filter.TotalPages) }
							</span>

							if vm.Filter.Page < vm.Filter.TotalPages {
								<a
									href={ templ.SafeURL("/admin/fontes" + vm.Filter.BuildQueryString(vm.Filter.Page+1)) }
									class="btn-pagination"
								>
									Próxima &rarr;
								</a>
							} else {
								<span class="btn-pagination disabled">Próxima &rarr;</span>
							}
						</nav>
					}
				}
			</main>
		</body>
	</html>
}
