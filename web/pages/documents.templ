package pages

import (
	"fmt"
	"github.com/raphaieu/vorcarozap/web/components"
)

templ Documents(vm DocumentListVM) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Catálogo público de documentos, laudos periciais, peças judiciais e reportagens vinculadas ao caso Daniel Vorcaro e Banco Master. Sequências contextuais e fontes rastreáveis."/>
			<title>Documentos e Fontes — VorcaroZAP</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body>
			@components.Header()
			<main class="container">
				<!-- Aviso Editorial Obrigatório -->
				<section class="editorial-notice" aria-label="Aviso Legal e Editorial">
					<strong>Aviso Editorial e Cadeia de Custódia</strong>
					<p>
						Catálogo de fontes documentais e peças investigativas vinculadas a alegações públicas ativas. A citação de qualquer documento nesta plataforma decorre de referência factual e <strong>não presume culpa, ilícito ou julgamento moral</strong> dos nomes referenciados. Consulte nossa <a href="/metodologia" class="notice-link">Metodologia e Critérios Editoriais</a>.
					</p>
				</section>

				<!-- Cabeçalho da Página -->
				<header class="page-intro">
					<h1 class="page-title">Documentos e Fontes</h1>
					<p class="page-subtitle">
						Consulte peças judiciais, laudos periciais, notas oficiais e matérias jornalísticas com visualização das sequências contextuais de trechos citados.
					</p>
				</header>

				<!-- Formulário de Busca e Filtros (100% Funcional sem JavaScript) -->
				<section class="card filter-card" aria-label="Busca e Filtros de Documentos">
					<form method="GET" action="/documentos" class="filter-form">
						<div class="search-row">
							<div class="form-group flex-grow">
								<label for="search-input" class="form-label">Buscar Documentos</label>
								<input
									type="search"
									id="search-input"
									name="q"
									class="form-control"
									placeholder="Título do documento, veículo, órgão ou autor..."
									value={ vm.Filter.Search }
								/>
							</div>
							<div class="form-actions-inline">
								<button type="submit" class="btn btn-primary" id="btn-search">Buscar</button>
								if vm.Filter.Search != "" || vm.Filter.SourceType != "" || vm.Filter.AccessStatus != "" || vm.Filter.OrderBy != "title" || vm.Filter.OrderDir != "asc" {
									<a href="/documentos" class="btn btn-subtle" title="Limpar todos os filtros">Limpar</a>
								}
							</div>
						</div>

						<div class="filters-grid">
							<!-- Tipo de Documento / Fonte -->
							<div class="form-group">
								<label for="filter-type" class="form-label">Tipo de Documento</label>
								<select id="filter-type" name="source_type" class="form-control">
									<option value="">Todos os tipos</option>
									for _, opt := range vm.Filter.AvailableTypes {
										if opt.Value == vm.Filter.SourceType {
											<option value={ opt.Value } selected>{ opt.Label }</option>
										} else {
											<option value={ opt.Value }>{ opt.Label }</option>
										}
									}
								</select>
							</div>

							<!-- Status de Acessibilidade -->
							<div class="form-group">
								<label for="filter-status" class="form-label">Status de Acessibilidade</label>
								<select id="filter-status" name="access_status" class="form-control">
									<option value="">Todos os status</option>
									for _, opt := range vm.Filter.AvailableStatuses {
										if opt.Value == vm.Filter.AccessStatus {
											<option value={ opt.Value } selected>{ opt.Label }</option>
										} else {
											<option value={ opt.Value }>{ opt.Label }</option>
										}
									}
								</select>
							</div>

							<!-- Ordenação -->
							<div class="form-group">
								<label for="filter-sort" class="form-label">Ordenar por</label>
								<select id="filter-sort" name="sort" class="form-control">
									<option value="title" selected?={ vm.Filter.OrderBy == "title" }>Título do documento</option>
									<option value="publisher" selected?={ vm.Filter.OrderBy == "publisher" }>Veículo / Autor</option>
									<option value="updated" selected?={ vm.Filter.OrderBy == "updated" }>Data de atualização</option>
									<option value="citations" selected?={ vm.Filter.OrderBy == "citations" }>Quantidade de citações</option>
								</select>
							</div>

							<!-- Direção -->
							<div class="form-group">
								<label for="filter-dir" class="form-label">Direção</label>
								<select id="filter-dir" name="dir" class="form-control">
									<option value="asc" selected?={ vm.Filter.OrderDir == "asc" }>Crescente (A&rarr;Z / Menor)</option>
									<option value="desc" selected?={ vm.Filter.OrderDir == "desc" }>Decrescente (Z&rarr;A / Maior)</option>
								</select>
							</div>
						</div>
					</form>
				</section>

				<!-- Indicador de Resultados -->
				<div class="results-count-bar">
					<span class="results-count">
						if vm.Filter.TotalCount == 1 {
							<strong>1</strong> documento público encontrado
						} else {
							<strong>{ fmt.Sprintf("%d", vm.Filter.TotalCount) }</strong> documentos públicos encontrados
						}
					</span>
				</div>

				<!-- Grade de Cartões de Documentos -->
				if len(vm.Documents) > 0 {
					<section class="cards-grid" aria-label="Lista de Documentos Públicos">
						for _, doc := range vm.Documents {
							<article class="card entity-card" id={ fmt.Sprintf("doc-%s", doc.ID) }>
								<div class="entity-card-header">
									<div class="badge-cluster">
										if doc.IsPrimaryDocument {
											<span class="source-type-badge source-type-primary" title={ doc.NatureLabel }>{ doc.SourceTypeHuman }</span>
										} else if doc.SourceTypeHuman != "" {
											<span class="source-type-badge" title={ doc.NatureLabel }>{ doc.SourceTypeHuman }</span>
										}
										<span class="category-badge">{ doc.NatureLabel }</span>
										if doc.SourceAccessStatus == "reachable" {
											<span class="admin-status-badge status-published">Acessível</span>
										} else if doc.SourceAccessStatus == "unreachable" {
											<span class="admin-status-badge status-rejected">Inacessível</span>
										} else if doc.SourceAccessStatus == "cited_by_provider" {
											<span class="admin-status-badge" style="background-color: #cfe2ff; color: #084298;">Citada</span>
										}
									</div>
									<h2 class="entity-card-title">
										<a href={ templ.SafeURL(doc.ViewerURL) } class="entity-title-link">
											if doc.IsTitleEnriched {
												{ doc.Title }
											} else {
												<span class="source-title-pending">[Título pendente de enriquecimento]</span>
											}
										</a>
									</h2>
									if doc.IsAuthorEnriched {
										<p class="entity-role">
											<strong>Veículo / Autor:</strong> { doc.PublisherOrAuthor }
										</p>
									}
								</div>

								if doc.FirstPublicExcerpt != "" {
									<div class="card-excerpt-preview" style="margin: 0.75rem 0; padding: 0.6rem 0.75rem; background: var(--color-surface-variant, #f8f9fa); border-left: 3px solid var(--color-primary, #0d6efd); border-radius: 4px;">
										if doc.FirstPublicLocator != "" {
											<div class="source-locator-box" style="margin-bottom: 0.35rem;">
												<span class="source-locator-label" style="font-size: 0.78rem;">Localizador:</span>
												<span class="source-locator-chip" style="font-size: 0.78rem;"><strong>{ doc.FirstPublicLocator }</strong></span>
											</div>
										}
										<blockquote class="source-excerpt" style="font-size: 0.92rem; line-height: 1.45; margin: 0; color: var(--color-text, #212529);">
											&ldquo;{ doc.FirstPublicExcerpt }&rdquo;
										</blockquote>
									</div>
								}

								<div class="entity-card-meta">
									<span class="meta-item">
										<strong>Citações públicas:</strong> { fmt.Sprintf("%d", doc.CitationsCount) }
									</span>
									<span class="meta-item">
										<strong>Entidades vinculadas:</strong> { fmt.Sprintf("%d", doc.EntitiesCount) }
									</span>
									if doc.HighestGradeHuman != "" {
										<span class="meta-item">
											<strong>Grau da alegação:</strong> { doc.HighestGradeHuman }
										</span>
									}
									if doc.PublishedAtHuman != "" {
										<span class="meta-item meta-date">
											<strong>Publicado em:</strong> { doc.PublishedAtHuman }
										</span>
									}
									if doc.AccessedAtHuman != "" {
										<span class="meta-item meta-date">
											<strong>Coletado em:</strong> { doc.AccessedAtHuman }
										</span>
									}
								</div>

								<div class="card-footer">
									<a href={ templ.SafeURL(doc.ViewerURL) } class="btn-card-action">
										Inspecionar documento e trechos &rarr;
									</a>
								</div>
							</article>
						}
					</section>

					<!-- Paginação -->
					if vm.Filter.TotalPages > 1 {
						<nav class="pagination-nav" aria-label="Paginação dos resultados">
							if vm.Filter.Page > 1 {
								<a href={ templ.SafeURL("/documentos" + vm.Filter.BuildQueryString(vm.Filter.Page - 1)) } class="btn btn-pagination" rel="prev">
									&larr; Anterior
								</a>
							} else {
								<span class="btn btn-pagination disabled" aria-disabled="true">&larr; Anterior</span>
							}

							<span class="pagination-status">
								Página { fmt.Sprintf("%d", vm.Filter.Page) } de { fmt.Sprintf("%d", vm.Filter.TotalPages) }
							</span>

							if vm.Filter.Page < vm.Filter.TotalPages {
								<a href={ templ.SafeURL("/documentos" + vm.Filter.BuildQueryString(vm.Filter.Page + 1)) } class="btn btn-pagination" rel="next">
									Próxima &rarr;
								</a>
							} else {
								<span class="btn btn-pagination disabled" aria-disabled="true">Próxima &rarr;</span>
							}
						</nav>
					}
				} else {
					<!-- Estado Vazio -->
					<section class="card empty-state" aria-label="Nenhum resultado">
						<h3>Nenhum documento encontrado</h3>
						<p>
							Não foram encontrados documentos públicos para a busca ou filtros selecionados.
						</p>
						<a href="/documentos" class="btn btn-primary" style="display: inline-block; margin-top: 1rem;">
							Ver todos os documentos
						</a>
					</section>
				}
			</main>
			<footer class="site-footer">
				<p>VorcaroZAP &bull; Base investigativa e documental independente &bull; <a href="/metodologia" style="color: inherit; text-decoration: underline;">Metodologia e Fontes</a></p>
			</footer>
		</body>
	</html>
}
