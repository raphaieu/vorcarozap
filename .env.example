# ==============================================================================
# VorcaroZAP - Configuração de Ambiente
# ==============================================================================

# Servidor HTTP
# APP_PORT: porta interna em que a aplicação Go escuta dentro do container (padrão: 8080)
APP_PORT=8080
# HOST_PORT: porta exposta no host para mapeamento pelo Docker Compose (padrão: 8090)
HOST_PORT=8090
APP_ENV=development

# Portas do proxy Caddy (opcional, sob profile 'proxy')
CADDY_HTTP_PORT=8000
CADDY_HTTPS_PORT=8443

# Banco de dados SQLite
DB_PATH=./data/vorcarozap.db

# Data de corte dos dados públicos da curadoria inicial (formato YYYY-MM-DD)
PUBLIC_DATA_CUTOFF=2026-09-03

# Timeouts HTTP
APP_READ_TIMEOUT=5s
APP_WRITE_TIMEOUT=10s
APP_IDLE_TIMEOUT=60s

# ==============================================================================
# Configurações Futuras (Documentadas para Fases Posteriores)
# ==============================================================================

# Verificador de fontes (VZ-020):
# As variáveis abaixo definem a política para fontes com status 'not_checked'.
# Defaults seguros documentados conforme ADR-006:
SOURCE_NOT_CHECKED_POLICY_OPENROUTER=quarantine
SOURCE_NOT_CHECKED_POLICY_CURATED_SEED=allow
SOURCE_CHECK_TIMEOUT=5s

# OpenRouter e Descoberta via Web Search (VZ-010):
# Chave de API do OpenRouter (obrigatória para monitoramento/descoberta, sem valor default):
OPENROUTER_API_KEY=
# Endpoint de completions (padrão: https://openrouter.ai/api/v1/chat/completions):
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Modelo utilizado para a etapa de descoberta (padrão: openai/gpt-4.1-mini):
OPENROUTER_DISCOVERY_MODEL=openai/gpt-4.1-mini
# Modelo utilizado para o gate semântico de verificação documental (padrão: openai/gpt-4.1-mini):
OPENROUTER_VERIFICATION_MODEL=openai/gpt-4.1-mini
# Timeout HTTP para chamadas ao OpenRouter (padrão: 30s):
OPENROUTER_TIMEOUT=30s
# Mecanismo de busca: auto | native | exa | firecrawl | parallel | perplexity (padrão: auto):
OPENROUTER_WEB_SEARCH_ENGINE=auto
# Limite de resultados por chamada de busca na web (1..25, padrão: 5):
OPENROUTER_WEB_SEARCH_MAX_RESULTS=5
# Limite cumulativo de resultados retornados por requisição (padrão: 15):
OPENROUTER_WEB_SEARCH_MAX_TOTAL_RESULTS=15
# Limite de execuções de busca permitidas pelo modelo em uma única requisição (padrão: 3):
OPENROUTER_WEB_SEARCH_MAX_USES=3
# Limite máximo de tool calls por requisição (1..30, padrão: 5):
OPENROUTER_MAX_TOOL_CALLS=5

# Monitoramento Operacional, Janela e Orçamento (VZ-013):
# Janela temporal máxima de retroação para busca incremental (padrão: 24h, máximo: 720h):
MONITOR_WINDOW=24h
# Limite de candidatos brutos a descobrir por execução (1..100, padrão: 10):
MONITOR_MAX_CANDIDATES_PER_RUN=10
# Limite máximo de verificações semânticas executadas por run (1..100, padrão: 10):
MONITOR_MAX_VERIFICATIONS_PER_RUN=10
# Limite orçamentário de custo de LLM por execução em USD (padrão: 0.25):
MONITOR_MAX_COST_PER_RUN_USD=0.25
# Limite orçamentário diário acumulado de custo de LLM em USD (padrão: 1.00):
MONITOR_MAX_COST_PER_DAY_USD=1.00
# TTL do lease de lock SQLite para evitar execuções concorrentes (padrão: 10m):
MONITOR_LOCK_TTL=10m

# Painel Administrativo e Proteção HTTP Basic Auth + CSRF (VZ-014, VZ-016):
# Para habilitar o acesso administrativo em /admin, configure as variáveis abaixo.
# ADMIN_USER: Nome de usuário (não pode ser vazio, conter ':' ou caracteres de controle; máx 128 chars).
# ADMIN_PASSWORD_HASH: Hash bcrypt válido gerado com custo entre 12 e 14 (ex: $2a$12$... ou $2b$12$...).
# ADMIN_ALLOWED_ORIGIN: Origem HTTP/HTTPS permitida para proteção CSRF em formulários mutantes (ex: http://localhost:8090).
# NUNCA informe senha em texto puro; apenas hashes bcrypt na faixa de custo 12–14 são aceitos.
# Se ambas as variáveis estiverem ausentes/comentadas, o endpoint /admin responderá 404 (desabilitado).
# ADMIN_USER=admin
# ADMIN_PASSWORD_HASH=$2a$12$e8MrO000000000000000000000000000000000000000000000000
# ADMIN_ALLOWED_ORIGIN=http://localhost:8090
