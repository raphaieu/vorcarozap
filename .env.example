# ==============================================================================
# VorcaroZAP - Configuração de Ambiente
# ==============================================================================

# Servidor HTTP
# APP_PORT: porta interna em que a aplicação Go escuta dentro do container (padrão: 8080)
APP_PORT=8080
# HOST_PORT: porta exposta no host para mapeamento pelo Docker Compose (padrão: 8090)
HOST_PORT=8090
# APP_BIND_ADDR: endereço de bind no host para a aplicação Go (padrão: 127.0.0.1 para segurança em VPS)
APP_BIND_ADDR=127.0.0.1
APP_ENV=development

# Proxy Caddy e HTTPS Automático (perfis 'prod' e 'proxy')
# SITE_DOMAIN: Domínio FQDN para HTTPS automático (ex: vorcarozap.exemplo.org) ou :80 para HTTP local
SITE_DOMAIN=:80
# Portas externas expostas pelo Caddy no host
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Banco de dados SQLite
DB_PATH=./data/vorcarozap.db

# Data de corte dos dados públicos da curadoria inicial (formato YYYY-MM-DD)
PUBLIC_DATA_CUTOFF=2026-09-03

# Timeouts HTTP
APP_READ_TIMEOUT=5s
APP_WRITE_TIMEOUT=10s
APP_IDLE_TIMEOUT=60s

# ==============================================================================
# Configurações Futuras (Documentadas para Fases Posteriores)
# ==============================================================================

# Verificador de fontes (VZ-020):
# As variáveis abaixo definem a política para fontes com status 'not_checked'.
# Defaults seguros documentados conforme ADR-006:
SOURCE_NOT_CHECKED_POLICY_OPENROUTER=quarantine
SOURCE_NOT_CHECKED_POLICY_CURATED_SEED=allow
SOURCE_CHECK_TIMEOUT=5s

# OpenRouter e Descoberta via Web Search (VZ-010):
# Chave de API do OpenRouter (obrigatória para monitoramento/descoberta, sem valor default):
OPENROUTER_API_KEY=
# Endpoint de completions (padrão: https://openrouter.ai/api/v1/chat/completions):
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Modelo utilizado para a etapa de descoberta (padrão: openai/gpt-4.1-mini):
OPENROUTER_DISCOVERY_MODEL=openai/gpt-4.1-mini
# Modelo utilizado para o gate semântico de verificação documental (padrão: openai/gpt-4.1-mini):
OPENROUTER_VERIFICATION_MODEL=openai/gpt-4.1-mini
# Timeout HTTP para chamadas ao OpenRouter (padrão: 30s):
OPENROUTER_TIMEOUT=30s
# Mecanismo de busca: auto | native | exa | firecrawl | parallel | perplexity (padrão: auto):
OPENROUTER_WEB_SEARCH_ENGINE=auto
# Limite de resultados por chamada de busca na web (1..25, padrão: 5):
OPENROUTER_WEB_SEARCH_MAX_RESULTS=5
# Limite cumulativo de resultados retornados por requisição (padrão: 15):
OPENROUTER_WEB_SEARCH_MAX_TOTAL_RESULTS=15
# Limite de execuções de busca permitidas pelo modelo em uma única requisição (padrão: 3):
OPENROUTER_WEB_SEARCH_MAX_USES=3
# Limite máximo de tool calls por requisição (1..30, padrão: 5):
OPENROUTER_MAX_TOOL_CALLS=5

# Monitoramento Operacional, Janela e Orçamento (VZ-013):
# Janela temporal máxima de retroação para busca incremental (padrão: 24h, máximo: 720h):
MONITOR_WINDOW=24h
# Limite de candidatos brutos a descobrir por execução (1..100, padrão: 10):
MONITOR_MAX_CANDIDATES_PER_RUN=10
# Limite máximo de verificações semânticas executadas por run (1..100, padrão: 10):
MONITOR_MAX_VERIFICATIONS_PER_RUN=10
# Limite orçamentário de custo de LLM por execução em USD (padrão: 0.25):
MONITOR_MAX_COST_PER_RUN_USD=0.25
# Limite orçamentário diário acumulado de custo de LLM em USD (padrão: 1.00):
MONITOR_MAX_COST_PER_DAY_USD=1.00
# TTL do lease de lock SQLite para evitar execuções concorrentes (padrão: 10m):
MONITOR_LOCK_TTL=10m

# Painel Administrativo, Autenticação, RBAC e MFA (VZ-014, VZ-016, VZ-026):
# Para habilitar o acesso administrativo em /admin, configure as variáveis abaixo.
# ADMIN_USER: Nome de usuário inicial do administrador raiz (não pode ser vazio, conter ':' ou caracteres de controle; máx 128 chars).
# ADMIN_PASSWORD_HASH: Hash bcrypt válido gerado com custo entre 12 e 14 (ex: $2a$12$... ou $2b$12$...).
# ADMIN_ALLOWED_ORIGIN: Origem HTTP/HTTPS permitida para proteção CSRF e validação de cabeçalhos mutantes (ex: http://localhost:8090 ou https://vorcarozap.exemplo.org).
# ADMIN_MFA_ENCRYPTION_KEY: Chave operacional AES-256 (exatamente 32 bytes ASCII ou 64 caracteres hexadecimais) para criptografia do segredo TOTP em repouso no SQLite.
# ADMIN_SESSION_TTL: Duração da sessão administrativa (padrão: 8h; mín 15m, máx 168h).
# ADMIN_LOCKOUT_DURATION: Duração do bloqueio de conta após tentativas falhas (padrão: 15m; mín 1m, máx 24h).
# ADMIN_MAX_LOGIN_ATTEMPTS: Número máximo de tentativas incorretas de login antes do lockout (1..20, padrão: 5).
# ADMIN_MFA_REQUIRED: Exigência obrigatória de MFA para operações administrativas (padrão: true).
# NUNCA informe senha em texto puro; apenas hashes bcrypt na faixa de custo 12–14 são aceitos.
# Se ADMIN_USER ou ADMIN_PASSWORD_HASH estiverem ausentes/comentados, o endpoint /admin responderá 404 (desabilitado).
# ADMIN_USER=admin
# ADMIN_PASSWORD_HASH=$2a$12$e8MrO000000000000000000000000000000000000000000000000
# ADMIN_ALLOWED_ORIGIN=http://localhost:8090
# ADMIN_MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# ADMIN_SESSION_TTL=8h
# ADMIN_LOCKOUT_DURATION=15m
# ADMIN_MAX_LOGIN_ATTEMPTS=5
# ADMIN_MFA_REQUIRED=true

# Observabilidade e Logs Estruturados (VZ-027):
# LOG_FORMAT: Formato de saída de logs (text | json, padrão: json em production, text em development).
# LOG_LEVEL: Nível mínimo de log (DEBUG | INFO | WARN | ERROR, padrão: INFO).
LOG_FORMAT=text
LOG_LEVEL=INFO

# Backup Remoto e Retenção S3 / SigV4 (VZ-027):
# BACKUP_REMOTE_ENABLED: Habilita upload e retenção remota via S3 / HTTPS SigV4 (true | false, padrão: false).
# BACKUP_REMOTE_PROVIDER: Provedor de storage remoto (padrão: s3).
# BACKUP_REMOTE_ENDPOINT: Endpoint HTTPS do serviço S3 (ex: https://s3.us-east-1.amazonaws.com ou https://<account_id>.r2.cloudflarestorage.com).
# BACKUP_REMOTE_REGION: Região S3 (ex: us-east-1).
# BACKUP_REMOTE_BUCKET: Nome do bucket remoto de backup.
# BACKUP_REMOTE_PREFIX: Prefixo/diretório de armazenamento no bucket (padrão: backups).
# BACKUP_REMOTE_ACCESS_KEY: Access Key ID do provedor S3 (obrigatório se BACKUP_REMOTE_ENABLED=true).
# BACKUP_REMOTE_SECRET_KEY: Secret Access Key do provedor S3 (obrigatório se BACKUP_REMOTE_ENABLED=true).
# BACKUP_REMOTE_RETENTION_COUNT: Quantidade de backups remotos mantidos no ciclo de retenção (1..1000, padrão: 14).
# BACKUP_REMOTE_TIMEOUT: Timeout HTTP por operação de backup remoto (1s..10m, padrão: 60s).
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_PROVIDER=s3
BACKUP_REMOTE_ENDPOINT=https://s3.us-east-1.amazonaws.com
BACKUP_REMOTE_REGION=us-east-1
BACKUP_REMOTE_BUCKET=
BACKUP_REMOTE_PREFIX=backups
BACKUP_REMOTE_ACCESS_KEY=
BACKUP_REMOTE_SECRET_KEY=
BACKUP_REMOTE_RETENTION_COUNT=14
BACKUP_REMOTE_TIMEOUT=60s
