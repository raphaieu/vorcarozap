:80 {
	encode zstd gzip

	header {
		# Proteções HTTP adicionais no proxy
		# NOTA: Strict-Transport-Security removido do ambiente local (:80 HTTP).
		# Deve ser reativado na configuração de produção com HTTPS real.
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	reverse_proxy app:8080
}
